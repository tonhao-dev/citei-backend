{
  "name": "citei-backend",
  "version": "0.0.1",
  "description": "API do Citei.",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "5.1.0",
    "husky": "9.1.7",
    "nodemon": "3.1.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "express-async-errors": "3.1.1",
    "express-validator": "7.3.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "supertest": "6.3.4",
    "typeorm": "0.3.31"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node ./build/src/server.js",
    "dev": "nodemon src/server.ts",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  }
}
